<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately wrong bbs-2023 tests, for the self-test of the no-library gate (issue #57). Every test
    here passes with the native library. Without it, each does what a bbs-2023 test must not do: it
    passes, it is skipped, or it produces no result. The self-test of tools/check-bbs-tests-without-library.sh
    builds this project, runs the gate on it and requires exactly the findings in expected-findings.txt.
    It is intentionally NOT part of Credentials.sln: the solution's test run must not contain these tests.
  -->
  <PropertyGroup>
    <RootNamespace>Credentials.GateFixtures</RootNamespace>
    <AssemblyName>Credentials.GateFixtures</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Credentials.Rdfc\Credentials.Rdfc.csproj" />
    <ProjectReference Include="..\Credentials.TestSupport\Credentials.TestSupport.csproj" />
    <ProjectReference Include="..\Credentials.GateFixtures.Support\Credentials.GateFixtures.Support.csproj" />
  </ItemGroup>

</Project>
