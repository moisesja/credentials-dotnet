<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A support library for tests/Credentials.GateFixtures, with no tests that run on their own: it has the
    base classes of a test that the fixture project inherits through two levels. The gate has to follow a
    chain of base classes into an assembly that has no test results. Not part of Credentials.sln.
  -->
  <PropertyGroup>
    <RootNamespace>Credentials.GateFixtures.Support</RootNamespace>
    <AssemblyName>Credentials.GateFixtures.Support</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Credentials.Rdfc\Credentials.Rdfc.csproj" />
  </ItemGroup>

</Project>
