<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test-support library (not a test project, not packable). Holds:
    - the [FrTag] requirement-coverage attribute and the canonical requirement-id registry, so the
      FrCoverage gate has a single source of truth;
    - BbsNativeLibrary, the one place that decides whether a test that needs NetCrypto's native BBS
      library runs, is skipped or fails (issue #57).
    Referenced by every test project that tags its tests or runs bbs-2023.
  -->
  <PropertyGroup>
    <RootNamespace>Credentials.TestSupport</RootNamespace>
    <AssemblyName>Credentials.TestSupport</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- BbsNativeLibrary asks NetCrypto whether its native BBS library loaded, and skips a test through
       Xunit.SkippableFact. NetCrypto is already in the graph of every project that references this one,
       through Credentials.Core. This library must not reference Credentials.Rdfc, which the architecture
       tests keep out of their host. -->
  <ItemGroup>
    <PackageReference Include="NetCrypto" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

</Project>
