<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The no-library gate for bbs-2023 tests (issue #57). It runs the test assemblies again from copies of
    their output folders with NetCrypto's native BBS library removed, and requires every test of a bbs-2023
    test class to fail there. A tool, not a test project: tools/check-bbs-tests-without-library.sh and the
    CI build-test job drive it. Its logic is tested by Credentials.ArchitectureTests.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Credentials.BbsGate</RootNamespace>
    <AssemblyName>Credentials.BbsGate</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C# parser: which test classes are bbs-2023 classes is read off a syntax tree. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Credentials.ArchitectureTests" />
  </ItemGroup>

</Project>
