<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ============================================================================
         Stack libraries (the credentials-dotnet substrate). Every pin in this file was checked against
         the latest stable nuget.org release on 2026-11-19 (issue #52) and is at it, with two hold-backs,
         each explained at its entry: FluentAssertions (licence), and the .NET platform packages that reach
         consumers (Microsoft.Extensions.*, System.Formats.Cbor), which stay on the .NET 10 servicing line
         (D7) rather than move to .NET 11's 11.0.0. Not every entry is referenced by every project. They
         are declared centrally so a project only adds a versionless <PackageReference>.
         ============================================================================ -->
    <!-- Proofs + the faithful System.Text.Json serializer options (DataProofsJsonOptions.Default,
         which CredentialJson.Faithful derives from so signed-bytes == wire-bytes). -->
    <!-- 1.1.0 -> 1.5.0 (issue #20). DataProofs does not promise binary compatibility across minors:
         Jose 1.3.0 replaced JwsSigner..ctor(ISigner, string) with (ISigner, string, JwsKidPlacement), so a
         build against 1.1.0 threw MissingMethodException on every JOSE signing path once a consumer
         (e.g. DidComm.Core 1.4.1+) resolved Jose >= 1.3.0. Any floor move here therefore requires a
         rebuild + release, never just a consumer-side version float. 1.4.0 made malformed-input
         failures definitive (Failed, not Indeterminate) and throws ProofGenerationException at proof
         creation, which DataIntegrityMechanism wraps. 1.5.0 makes RDFC fail closed on JSON-LD data
         loss: undefined terms, malformed or respelled IRIs (security fix, dataproofs #36). 2.0.0: the
         Rdfc suites' constructors changed (binary break, source-compatible; rebuilt here), RDFC now
         carries @direction (dataproofs #40, rdfDirection: i18n-datatype), proof members a verifier acts on
         are bound to the signature (GHSA-6fxh-mc39-94vc), RDFC bytes changed for tied-blank-node documents,
         and bbs-2023 was reworked to interoperate with the reference implementation (earlier proofs do not
         verify; nothing issued before this release exists in the wild, by owner decision). -->
    <PackageVersion Include="DataProofsDotnet.Core" Version="2.0.0" />
    <PackageVersion Include="DataProofsDotnet.Rdfc" Version="2.0.0" />          <!-- M5: bbs-2023 / RDFC -->
    <PackageVersion Include="DataProofsDotnet.Jose" Version="2.0.0" />          <!-- M3/M4: JOSE + SD-JWT VC -->
    <PackageVersion Include="DataProofsDotnet.Cose" Version="2.0.0" />          <!-- M3: COSE -->
    <PackageVersion Include="DataProofsDotnet.Extensions.DependencyInjection" Version="2.0.0" />
    <!-- Security pin (issue #52, GHSA-vmv3-wvjp-wqpj / CVE-2026-118747): DataProofsDotnet.Cose and .Rdfc
         2.0.0 floor System.Formats.Cbor 10.0.8, whose duplicate-map-key check can be hash-flooded; 10.0.15
         is the patched 10.0 release. Only bbs-2023 proofValue parsing (strict mode) runs that check; COSE
         reads in lax mode. 10.0.15 also caps CBOR nesting at 64 levels (not in the advisory), so a deeply
         nested COSE header is now refused as malformed; M3EnvelopingTests pins it. Not used directly:
         Credentials.Core references it so the floor lands in its nuspec, and every Credentials package
         depends on Core, so consumers resolve >= 10.0.15. Stays on the 10.0 line (11.0.0 is also patched;
         see the header). Remove this pin once DataProofs floors a patched version (dataproofs-dotnet#50):
         a local pin below an upstream floor is NU1605 (tracked in #53). -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
    <!-- Engine crypto operations the engine performs itself: hashing/digests (NetCrypto.Hash),
         ISigner abstraction, JWK conversion. NetCrypto exposes no RNG abstraction; the engine's
         RNG seam wraps the BCL RandomNumberGenerator (see Credentials.Cryptography). -->
    <!-- 1.2.0 -> 1.7.1 (issue #20). DataProofsDotnet.Core 1.5.0 and NetDid.Core 4.0.0 both floor 1.7.1.
         1.4.0 -> 1.7.1 is additive (key-store custody APIs + hardening). Note 1.5.0+ verifies high-S ES256K
         signatures (normalizes to low-S), so ECDSA signature bytes are not unique: never key replay or
         dedup on signature bytes. -->
    <PackageVersion Include="NetCrypto" Version="1.7.1" />
    <!-- DID resolution + key store (M1+). 2.3.0 -> 4.0.0 (issue #20). No source change for the surfaces
         Credentials uses (IDidResolver, DidDocument, VerificationRelationshipEntry, AddNetDid/AddDidKey).
         NetDidBuilder, which appears in Credentials' public API via CredentialsBuilder.UseNetDid, changed
         additively only. 3.x/4.0 tightened DID syntax and DID-document validation, required a VM
         controller, and made relative VM ids legal; no did:key verdict changes. 4.0.0 floors
         Microsoft.Extensions.* 10.0.14 and NetCrypto 1.7.1. -->
    <PackageVersion Include="NetDid.Core" Version="4.0.0" />
    <PackageVersion Include="NetDid.Method.Key" Version="4.0.0" />
    <PackageVersion Include="NetDid.Extensions.DependencyInjection" Version="4.0.0" />
    <!-- Multibase/multihash for the Bitstring Status List codec (M2). -->
    <PackageVersion Include="NetCid" Version="1.6.0" />
    <!-- JSON Schema 2020-12 validation (M2). STJ-native; no Newtonsoft. 7.3.2 -> 9.5.0 (issue #20). This
         is an API break, ported in JsonSchema2020Validator. v9 registers built schemas in a process-wide
         registry unless the build gets its own local SchemaRegistry, and it throws JsonSchemaException for
         structurally invalid schemas. The validator isolates and catches both; SchemaValidatorTests pin it.
         9.6.0 -> 9.7.0 (issue #52): adds .NET 11 and a net10.0 build (9.6.0 had none, so net10.0 loaded its
         net9.0 build). Two dialect-specific changes: (1) `hostname` drops the IDNA A-label checks for draft 6
         and v1, which does not reach verification, because formats come from the build dialect and the
         validator fixes it to 2020-12; (2) v1 `$dynamicRef` now takes a bare anchor name and refuses "#name",
         which does reach it when a schema declares v1. That moves v1 schemas between Indeterminate and
         evaluated, never between Success and Failure. SchemaValidatorTests pin both. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.7.0" />
    <!-- No AngleSharp pin: the issue #18 security pin (1.5.2) was removed in issue #20 because
         DataProofsDotnet.Rdfc (>= 1.3.0) itself floors the patched AngleSharp >= 1.6.0. Keeping a local pin
         below an upstream floor is an NU1605 downgrade, so it would have to chase every DataProofs bump. -->

    <!-- Microsoft.Extensions. 10.0.8 -> 10.0.14 (issue #20): required, not optional. NetDid 4.0.0 floors
         10.0.14, so a direct reference below it is an NU1605 downgrade. 10.0.14 -> 10.0.15 (issue #52), the
         November 2026 .NET servicing release. Held on the 10.0 line, not 11.0.0: these floors reach every
         consumer's graph, the library targets .NET 10 (D7, NFR-001), and the rest of the stack (NetDid,
         DataProofs, DidComm) is on 10.0.x. 11.0.0 would put .NET 11 packages into every .NET 10 app and
         override ASP.NET Core 10's shared-framework copies; moving lines is a stack-wide owner decision.
         The Microsoft.Extensions.Caching.Memory entry was removed (issue #52): no project ever referenced it. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />

    <!-- Source Link. 10.0.300 -> 10.0.403 (issue #20): GHSA-23fw-v26w-5fgq covers the
         Microsoft.Build.Tasks.Git 10.0.300-10.0.301 it pulls in, and NU1902 fails restore under
         TreatWarningsAsErrors. Build-only (PrivateAssets=All), so it never reaches consumers.
         10.0.403 -> 11.0.100 (issue #52): its MSBuild tasks target net10.0 and run on the .NET 10 SDK. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />

    <!-- Public-API surface tracking (RS0016/RS0017): every public member must be declared in the
         committed PublicAPI.{Shipped,Unshipped}.txt, so an accidental surface change fails the build
         and an intentional one shows up as a reviewable text diff (NFR-005 semver guard). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!-- Architecture/surface tests: inspect built assemblies' public surface (incl. the opt-in
         Credentials.Rdfc) by metadata only, without runtime-loading them — so the no-Newtonsoft
         runtime-closure assertion stays valid in the same test host. Test-only, so it takes the latest
         (11.0.0, which ships a net10.0 build) without the consumer-floor concern above. -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="11.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- FluentAssertions held at 7.0.0, the one deliberate hold-back from "everything latest" (owner
         decision, 2026-10-29): 7.0.0 is the last release under the free Apache-2.0 license (v8+ requires a
         paid Xceed license for commercial use). Matches didcomm-dotnet. -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!-- Runtime-skippable xUnit facts: the conformance test skips (visibly) when the Node W3C suite
         isn't prepared, rather than silently passing or hard-failing. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>
